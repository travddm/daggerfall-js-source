# /etc/dfo-runner/runner.env  (root:dfo-ci, mode 0640). Read by dfo-runner@.service.
ORG=Daggerfall-JS
# From: gh api /orgs/Daggerfall-JS/actions/runner-groups --jq '.runner_groups[] | [.id,.name,.visibility] | @tsv'
RUNNER_GROUP_ID=0
# A file holding the GitHub token that mints runner configurations (mode 0400, owner dfo-ci).
TOKEN_FILE=/etc/dfo-runner/token
IMAGE=dfo-ci-runner:current
# The cores for slot N are FIRST_CPU + N*CPUS_PER_RUNNER ... + CPUS_PER_RUNNER-1 (see lscpu -e).
FIRST_CPU=8
CPUS_PER_RUNNER=4
MEMORY=8g
SHM_SIZE=1g
CACHE_DIR=/srv/dfo-ci/cache
NETWORK=dfo-ci
