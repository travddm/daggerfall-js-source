{
  "name": "daggerfall-js-source",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/testShards.mjs 1/1",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src/ server/src/ server-account/src/ test/ tools/ scripts/ app/ *.config.js",
    "test:changed": "node tools/testChanged.mjs",
    "test:shard": "node tools/testShards.mjs",
    "test:times": "node tools/testTimes.mjs",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format:check": "node tools/check-changed.mjs format-check",
    "format:fix": "node tools/check-changed.mjs format-fix",
    "markdown": "node tools/check-changed.mjs markdown",
    "spell": "node tools/check-changed.mjs spell",
    "check": "npm run lint && npm run types && npm test && npm run build",
    "prebuild": "node scripts/buildTag.mjs",
    "postbuild": "git checkout -- src/buildTag.js",
    "probes": "node tools/enhancedMenuProbe.mjs && node tools/featureRailProbe.mjs",
    "shot": "node tools/screenshot.mjs",
    "firsthour": "node tools/firstHourProbe.mjs",
    "x11": "node tools/x11Probe.mjs",
    "perf": "node tools/perfProbe.mjs",
    "x11c": "node tools/identifyOutdoorsProbe.mjs",
    "trademodes": "node tools/tradeModeProbe.mjs",
    "peoplegate": "node tools/peopleGateProbe.mjs",
    "levelup": "node tools/levelUpProbe.mjs",
    "blood": "node tools/bloodProbe.mjs",
    "account": "node tools/accountProbe.mjs",
    "load": "node tools/loadHarness.mjs",
    "acctcard": "node tools/accountCardProbe.mjs",
    "savetile": "node tools/saveTileProbe.mjs",
    "chargenphone": "node tools/chargenPhoneProbe.mjs",
    "deeds": "node tools/deedProbe.mjs",
    "mwinspect": "node tools/mwInspectProbe.mjs",
    "mwarm": "node tools/mwArmProbe.mjs",
    "mwviewer": "node tools/mwViewerProbe.mjs",
    "mwattach": "node tools/mwAttachProbe.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "acorn": "^8.18.0",
    "cspell": "^10.4.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.62.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
